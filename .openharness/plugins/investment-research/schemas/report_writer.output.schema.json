{
  "$defs": {
    "CatalystEvent": {
      "additionalProperties": false,
      "properties": {
        "affected_metrics": {
          "items": {
            "type": "string"
          },
          "title": "Affected Metrics",
          "type": "array"
        },
        "announced_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Announced At"
        },
        "catalyst_id": {
          "pattern": "^CAT-[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Catalyst Id",
          "type": "string"
        },
        "confidence_basis": {
          "minLength": 1,
          "title": "Confidence Basis",
          "type": "string"
        },
        "direction": {
          "enum": [
            "positive",
            "negative",
            "mixed",
            "uncertain"
          ],
          "title": "Direction",
          "type": "string"
        },
        "event_type": {
          "minLength": 1,
          "title": "Event Type",
          "type": "string"
        },
        "evidence_class": {
          "enum": [
            "disclosed_fact",
            "public_report",
            "market_expectation",
            "analysis_inference",
            "speculation"
          ],
          "title": "Evidence Class",
          "type": "string"
        },
        "expected_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Date"
        },
        "expected_window": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "failure_signals": {
          "items": {
            "type": "string"
          },
          "title": "Failure Signals",
          "type": "array"
        },
        "related_fact_ids": {
          "items": {
            "pattern": "^F-[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "title": "Related Fact Ids",
          "type": "array"
        },
        "source_ids": {
          "items": {
            "pattern": "^S-[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "transmission_path": {
          "minLength": 1,
          "title": "Transmission Path",
          "type": "string"
        }
      },
      "required": [
        "catalyst_id",
        "title",
        "event_type",
        "evidence_class",
        "confidence_basis",
        "transmission_path",
        "direction"
      ],
      "title": "CatalystEvent",
      "type": "object"
    },
    "DateRange": {
      "additionalProperties": false,
      "properties": {
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        }
      },
      "required": [
        "start_date",
        "end_date"
      ],
      "title": "DateRange",
      "type": "object"
    },
    "HandoffRequest": {
      "additionalProperties": false,
      "properties": {
        "input_refs": {
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "request": {
          "minLength": 1,
          "title": "Request",
          "type": "string"
        },
        "target_agent_id": {
          "enum": [
            "planner",
            "fundamental",
            "industry_competition",
            "market_catalyst",
            "risk",
            "reviewer_arbiter",
            "report_writer"
          ],
          "title": "Target Agent Id",
          "type": "string"
        }
      },
      "required": [
        "target_agent_id",
        "request"
      ],
      "title": "HandoffRequest",
      "type": "object"
    },
    "LogicCandidate": {
      "additionalProperties": false,
      "properties": {
        "counter_evidence_ids": {
          "items": {
            "pattern": "^F-[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "title": "Counter Evidence Ids",
          "type": "array"
        },
        "falsification_conditions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Falsification Conditions",
          "type": "array"
        },
        "logic_id": {
          "pattern": "^L-[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Logic Id",
          "type": "string"
        },
        "mechanism": {
          "minLength": 1,
          "title": "Mechanism",
          "type": "string"
        },
        "submitted_by": {
          "enum": [
            "planner",
            "fundamental",
            "industry_competition",
            "market_catalyst",
            "risk",
            "reviewer_arbiter",
            "report_writer"
          ],
          "title": "Submitted By",
          "type": "string"
        },
        "supporting_fact_ids": {
          "items": {
            "pattern": "^F-[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Supporting Fact Ids",
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "tracking_indicators": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Tracking Indicators",
          "type": "array"
        }
      },
      "required": [
        "logic_id",
        "title",
        "mechanism",
        "supporting_fact_ids",
        "falsification_conditions",
        "tracking_indicators",
        "submitted_by"
      ],
      "title": "LogicCandidate",
      "type": "object"
    },
    "PeerComparisonRow": {
      "additionalProperties": false,
      "properties": {
        "company_name": {
          "minLength": 1,
          "title": "Company Name",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "pattern": "^S-[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "ticker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ticker"
        },
        "values": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "company_name",
        "values"
      ],
      "title": "PeerComparisonRow",
      "type": "object"
    },
    "ReportBlocker": {
      "additionalProperties": false,
      "properties": {
        "problem": {
          "minLength": 1,
          "title": "Problem",
          "type": "string"
        },
        "required_record_ids": {
          "items": {
            "type": "string"
          },
          "title": "Required Record Ids",
          "type": "array"
        },
        "section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Id"
        }
      },
      "required": [
        "problem"
      ],
      "title": "ReportBlocker",
      "type": "object"
    },
    "ReportMetadata": {
      "additionalProperties": false,
      "properties": {
        "as_of_date": {
          "format": "date",
          "title": "As Of Date",
          "type": "string"
        },
        "catalyst_window": {
          "$ref": "#/$defs/DateRange"
        },
        "company_name": {
          "minLength": 1,
          "title": "Company Name",
          "type": "string"
        },
        "protocol_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Protocol Version",
          "type": "string"
        },
        "research_period": {
          "$ref": "#/$defs/DateRange"
        },
        "ticker": {
          "minLength": 1,
          "title": "Ticker",
          "type": "string"
        }
      },
      "required": [
        "company_name",
        "ticker",
        "as_of_date",
        "research_period",
        "catalyst_window"
      ],
      "title": "ReportMetadata",
      "type": "object"
    },
    "ReportSection": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "section_id": {
          "minLength": 1,
          "title": "Section Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "section_id",
        "title",
        "content"
      ],
      "title": "ReportSection",
      "type": "object"
    },
    "RiskItem": {
      "additionalProperties": false,
      "properties": {
        "affected_logic_ids": {
          "items": {
            "pattern": "^L-[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "title": "Affected Logic Ids",
          "type": "array"
        },
        "falsification_indicators": {
          "items": {
            "type": "string"
          },
          "title": "Falsification Indicators",
          "type": "array"
        },
        "impact_path": {
          "minLength": 1,
          "title": "Impact Path",
          "type": "string"
        },
        "monitoring_plan": {
          "items": {
            "type": "string"
          },
          "title": "Monitoring Plan",
          "type": "array"
        },
        "probability_basis": {
          "minLength": 1,
          "title": "Probability Basis",
          "type": "string"
        },
        "risk_id": {
          "pattern": "^RISK-[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Risk Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "pattern": "^S-[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "time_window": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Window"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "trigger_conditions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Trigger Conditions",
          "type": "array"
        }
      },
      "required": [
        "risk_id",
        "title",
        "trigger_conditions",
        "impact_path",
        "severity",
        "probability_basis"
      ],
      "title": "RiskItem",
      "type": "object"
    },
    "UnverifiedItem": {
      "additionalProperties": false,
      "properties": {
        "item": {
          "minLength": 1,
          "title": "Item",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "required_evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Evidence"
        }
      },
      "required": [
        "item",
        "reason"
      ],
      "title": "UnverifiedItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blocking_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Blocking Reasons",
      "type": "array"
    },
    "catalysts": {
      "items": {
        "$ref": "#/$defs/CatalystEvent"
      },
      "title": "Catalysts",
      "type": "array"
    },
    "completed_scope": {
      "items": {
        "type": "string"
      },
      "title": "Completed Scope",
      "type": "array"
    },
    "compliance_statement": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Compliance Statement"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "handoff_requests": {
      "items": {
        "$ref": "#/$defs/HandoffRequest"
      },
      "title": "Handoff Requests",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "metadata": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReportMetadata"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "peer_comparison": {
      "items": {
        "$ref": "#/$defs/PeerComparisonRow"
      },
      "title": "Peer Comparison",
      "type": "array"
    },
    "protocol_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "report_blockers": {
      "items": {
        "$ref": "#/$defs/ReportBlocker"
      },
      "title": "Report Blockers",
      "type": "array"
    },
    "risks": {
      "items": {
        "$ref": "#/$defs/RiskItem"
      },
      "title": "Risks",
      "type": "array"
    },
    "section_evidence_map": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Section Evidence Map",
      "type": "object"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/ReportSection"
      },
      "title": "Sections",
      "type": "array"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "blocked",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "three_approved_logics": {
      "items": {
        "$ref": "#/$defs/LogicCandidate"
      },
      "maxItems": 3,
      "title": "Three Approved Logics",
      "type": "array"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "tracking_indicators": {
      "items": {
        "type": "string"
      },
      "title": "Tracking Indicators",
      "type": "array"
    },
    "unverified_items": {
      "items": {
        "$ref": "#/$defs/UnverifiedItem"
      },
      "title": "Unverified Items",
      "type": "array"
    }
  },
  "required": [
    "status",
    "completed_scope",
    "evidence_refs",
    "unverified_items",
    "limitations",
    "handoff_requests",
    "blocking_reasons"
  ],
  "title": "ReportResult",
  "type": "object"
}
