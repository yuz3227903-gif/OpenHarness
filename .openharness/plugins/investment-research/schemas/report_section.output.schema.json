{
  "$defs": {
    "HandoffRequest": {
      "additionalProperties": false,
      "properties": {
        "input_refs": {
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "request": {
          "minLength": 1,
          "title": "Request",
          "type": "string"
        },
        "target_agent_id": {
          "enum": [
            "planner",
            "fundamental",
            "industry_competition",
            "market_catalyst",
            "risk",
            "reviewer_arbiter",
            "report_writer"
          ],
          "title": "Target Agent Id",
          "type": "string"
        }
      },
      "required": [
        "target_agent_id",
        "request"
      ],
      "title": "HandoffRequest",
      "type": "object"
    },
    "UnverifiedItem": {
      "additionalProperties": false,
      "properties": {
        "item": {
          "minLength": 1,
          "title": "Item",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "required_evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Evidence"
        }
      },
      "required": [
        "item",
        "reason"
      ],
      "title": "UnverifiedItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Structured output for one independently generated report chapter.",
  "properties": {
    "blocking_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Blocking Reasons",
      "type": "array"
    },
    "completed_scope": {
      "items": {
        "type": "string"
      },
      "title": "Completed Scope",
      "type": "array"
    },
    "content": {
      "minLength": 1,
      "title": "Content",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "handoff_requests": {
      "items": {
        "$ref": "#/$defs/HandoffRequest"
      },
      "title": "Handoff Requests",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "logic_ids": {
      "items": {
        "pattern": "^L-[A-Za-z0-9][A-Za-z0-9_-]*$",
        "type": "string"
      },
      "maxItems": 3,
      "title": "Logic Ids",
      "type": "array"
    },
    "protocol_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "section_id": {
      "enum": [
        "company_overview",
        "operating_changes",
        "investment_logics",
        "peer_comparison",
        "catalysts",
        "risks",
        "tracking_indicators",
        "limitations"
      ],
      "title": "Section Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "blocked",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "unverified_items": {
      "items": {
        "$ref": "#/$defs/UnverifiedItem"
      },
      "title": "Unverified Items",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "status",
    "completed_scope",
    "evidence_refs",
    "unverified_items",
    "limitations",
    "handoff_requests",
    "blocking_reasons",
    "section_id",
    "title",
    "content"
  ],
  "title": "ReportSectionResult",
  "type": "object"
}
