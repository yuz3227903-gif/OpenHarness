{
  "$defs": {
    "CompanyIdentity": {
      "additionalProperties": false,
      "properties": {
        "exchange": {
          "minLength": 1,
          "title": "Exchange",
          "type": "string"
        },
        "legal_name": {
          "minLength": 1,
          "title": "Legal Name",
          "type": "string"
        },
        "primary_business": {
          "minLength": 1,
          "title": "Primary Business",
          "type": "string"
        },
        "short_name": {
          "minLength": 1,
          "title": "Short Name",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "pattern": "^S-[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "ticker": {
          "minLength": 1,
          "title": "Ticker",
          "type": "string"
        }
      },
      "required": [
        "legal_name",
        "short_name",
        "ticker",
        "exchange",
        "primary_business"
      ],
      "title": "CompanyIdentity",
      "type": "object"
    },
    "CompetitorCandidate": {
      "additionalProperties": false,
      "properties": {
        "company_name": {
          "minLength": 1,
          "title": "Company Name",
          "type": "string"
        },
        "comparability_limits": {
          "items": {
            "type": "string"
          },
          "title": "Comparability Limits",
          "type": "array"
        },
        "exchange": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange"
        },
        "selection_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Selection Reasons",
          "type": "array"
        },
        "source_ids": {
          "items": {
            "pattern": "^S-[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "ticker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ticker"
        }
      },
      "required": [
        "company_name"
      ],
      "title": "CompetitorCandidate",
      "type": "object"
    },
    "DateRange": {
      "additionalProperties": false,
      "properties": {
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        }
      },
      "required": [
        "start_date",
        "end_date"
      ],
      "title": "DateRange",
      "type": "object"
    },
    "Gate1Payload": {
      "additionalProperties": false,
      "properties": {
        "catalyst_window": {
          "$ref": "#/$defs/DateRange"
        },
        "company_identity": {
          "$ref": "#/$defs/CompanyIdentity"
        },
        "recommended_competitors": {
          "items": {
            "$ref": "#/$defs/CompetitorCandidate"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Recommended Competitors",
          "type": "array"
        },
        "research_period": {
          "$ref": "#/$defs/DateRange"
        }
      },
      "required": [
        "company_identity",
        "research_period",
        "catalyst_window",
        "recommended_competitors"
      ],
      "title": "Gate1Payload",
      "type": "object"
    },
    "HandoffRequest": {
      "additionalProperties": false,
      "properties": {
        "input_refs": {
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "request": {
          "minLength": 1,
          "title": "Request",
          "type": "string"
        },
        "target_agent_id": {
          "enum": [
            "planner",
            "fundamental",
            "industry_competition",
            "market_catalyst",
            "risk",
            "reviewer_arbiter",
            "report_writer"
          ],
          "title": "Target Agent Id",
          "type": "string"
        }
      },
      "required": [
        "target_agent_id",
        "request"
      ],
      "title": "HandoffRequest",
      "type": "object"
    },
    "TaskPlanItem": {
      "additionalProperties": false,
      "properties": {
        "assigned_agent_id": {
          "enum": [
            "planner",
            "fundamental",
            "industry_competition",
            "market_catalyst",
            "risk",
            "reviewer_arbiter",
            "report_writer"
          ],
          "title": "Assigned Agent Id",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "pattern": "^TASK-[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "expected_output": {
          "minLength": 1,
          "title": "Expected Output",
          "type": "string"
        },
        "input_refs": {
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "objective": {
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "task_id": {
          "pattern": "^TASK-[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "assigned_agent_id",
        "objective",
        "expected_output"
      ],
      "title": "TaskPlanItem",
      "type": "object"
    },
    "UnverifiedItem": {
      "additionalProperties": false,
      "properties": {
        "item": {
          "minLength": 1,
          "title": "Item",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "required_evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Evidence"
        }
      },
      "required": [
        "item",
        "reason"
      ],
      "title": "UnverifiedItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "available_materials": {
      "items": {
        "type": "string"
      },
      "title": "Available Materials",
      "type": "array"
    },
    "blocking_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Blocking Reasons",
      "type": "array"
    },
    "catalyst_window": {
      "anyOf": [
        {
          "$ref": "#/$defs/DateRange"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "company_identity": {
      "anyOf": [
        {
          "$ref": "#/$defs/CompanyIdentity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "competitor_candidates": {
      "items": {
        "$ref": "#/$defs/CompetitorCandidate"
      },
      "title": "Competitor Candidates",
      "type": "array"
    },
    "completed_scope": {
      "items": {
        "type": "string"
      },
      "title": "Completed Scope",
      "type": "array"
    },
    "dependency_graph": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Dependency Graph",
      "type": "object"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "gate_1_payload": {
      "anyOf": [
        {
          "$ref": "#/$defs/Gate1Payload"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "handoff_requests": {
      "items": {
        "$ref": "#/$defs/HandoffRequest"
      },
      "title": "Handoff Requests",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "material_gaps": {
      "items": {
        "type": "string"
      },
      "title": "Material Gaps",
      "type": "array"
    },
    "protocol_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "recommended_competitors": {
      "items": {
        "$ref": "#/$defs/CompetitorCandidate"
      },
      "maxItems": 2,
      "title": "Recommended Competitors",
      "type": "array"
    },
    "research_period": {
      "anyOf": [
        {
          "$ref": "#/$defs/DateRange"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "blocked",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "task_plan": {
      "items": {
        "$ref": "#/$defs/TaskPlanItem"
      },
      "title": "Task Plan",
      "type": "array"
    },
    "unverified_items": {
      "items": {
        "$ref": "#/$defs/UnverifiedItem"
      },
      "title": "Unverified Items",
      "type": "array"
    }
  },
  "required": [
    "status",
    "completed_scope",
    "evidence_refs",
    "unverified_items",
    "limitations",
    "handoff_requests",
    "blocking_reasons"
  ],
  "title": "PlannerResult",
  "type": "object"
}
